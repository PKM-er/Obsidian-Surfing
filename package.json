{
	"name": "surfing",
	"version": "0.9.14",
	"description": "Use surfing to surf the net in Obsidian.",
	"main": "main.js",
	"scripts": {
		"lint": "npm run review",
		"dev": "vite build --watch --mode=development",
		"build": "vite build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"review": "node tools/review/node_modules/eslint/bin/eslint.js -c tools/review/eslint.config.mjs .",
		"review:install": "npm --prefix tools/review install",
		"prepare": "husky",
		"typecheck": "tsc -p tsconfig.json && tsc -p src/extensions/tsconfig.json",
		"test": "npm run test:extensions && npm run test:mcp",
		"test:mcp": "node scripts/build-mcp.mjs && node tests/mcp/run-all.mjs",
		"test:extensions": "node scripts/build-extensions.mjs && node tests/extensions/run-all.mjs"
	},
	"keywords": [],
	"author": "Boninall & Windily-cloud",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@electron/remote": "^2.1.3",
		"@popperjs/core": "^2.11.6",
		"@rollup/plugin-commonjs": "^25.0.7",
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-replace": "^5.0.5",
		"@rollup/plugin-terser": "^0.4.4",
		"@types/node": "^22.20.5",
		"electron": "^43.7.11",
		"esbuild": "^0.28.2",
		"husky": "^9.1.6",
		"monkey-around": "^2.3.0",
		"obsidian": "^1.14.4",
		"tslib": "2.4.0",
		"typescript": "^7.0.2",
		"vite": "^5.0.12"
	},
	"dependencies": {
		"defuddle": "^0.6.6"
	}
}
